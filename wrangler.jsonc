{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mmdhastam22",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",

  "routes": [
    { "pattern": "ymaos1475963.shop/appfaaliat/*", "zone_name": "ymaos1475963.shop" }
  ],

  "d1_databases": [
    { "binding": "DB", "database_name": "activity-db", "database_id": "شناسه-UUID-را-اینجا-بگذار" }
  ],

  "vars": {
    "BASE_PATH": "/appfaaliat",
    "SMS_PROVIDER": "console",
    "SESSION_DAYS": "30"
  },

  "observability": { "enabled": true }
}

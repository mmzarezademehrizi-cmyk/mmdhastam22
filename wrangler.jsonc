{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "activity-api",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",

  // The API answers on https://ymaos1475963.shop/appfaaliat/...
  // (the rest of the domain keeps working as it does now).
  "routes": [
    { "pattern": "ymaos1475963.shop/appfaaliat/*", "zone_name": "ymaos1475963.shop" }
  ],

  // Create the database once:   npx wrangler d1 create activity-db
  // then paste the printed database_id below (or bind it in the Cloudflare dashboard / install-proje panel).
  "d1_databases": [
    { "binding": "DB", "database_name": "activity-db", "database_id": "PUT_YOUR_D1_DATABASE_ID_HERE" }
  ],

  "vars": {
    "BASE_PATH": "/appfaaliat",
    "SMS_PROVIDER": "console",
    "SESSION_DAYS": "30"
  },

  "observability": { "enabled": true }
  // Secrets (never put them in this file):
  //   npx wrangler secret put APP_JWT_SECRET     (random, at least 32 characters)
  //   npx wrangler secret put SETUP_KEY          (random, at least 12 characters; used once to create the owner)
}
